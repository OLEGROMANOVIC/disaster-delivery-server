# Copy to .env (Colyseus loads it automatically) or set these on your host.
PORT=2567
NODE_ENV=production
# Optional label shown in /health. The client tags rooms with its own region key
# (eu / us), so the same build can run in every Colyseus Cloud region.
REGION=
# Comma-separated: exact host, ".suffix" for subdomains, or a full origin.
# Keep localhost entries out of production.
ALLOWED_ORIGINS=.crazygames.com,localhost,127.0.0.1
# Node test clients send no Origin header; never allow that in production.
ALLOW_EMPTY_ORIGIN=false
# Optional: only accept CrazyGames tokens issued for this game id.
CRAZYGAMES_GAME_ID=
# Match tuning (seconds)
MATCH_SECONDS=240
INTERMISSION_SECONDS=12
LATE_JOIN_SECONDS=45
RECONNECT_SECONDS=20

# Milestone 3 tuning / test hooks (all optional)
# Which disasters can be scheduled: tornado,flood  (or "none")
DISASTER_TYPES=tornado,flood
# Force specific flood zones (ids F1..F9 from shared.js) instead of random picks
FLOOD_ZONES=
# Force a tornado path "x,z;x,z;..." (ping-pongs); empty = random road walk
TORNADO_PATH=
# Restrict package types that spawn (box,groceries,crate,aquarium,sofa,piano,vip)
PACKAGE_POOL=
# Condition lost when dropping a fragile package while running (default 12)
DROP_DAMAGE=
