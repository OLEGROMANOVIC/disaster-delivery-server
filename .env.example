# Copy to .env (Colyseus loads it automatically) or set these on your host.
PORT=2567
NODE_ENV=production
# Optional label shown in /health. The client tags rooms with its own region key
# (eu / us), so the same build can run in every Colyseus Cloud region.
REGION=
# Comma-separated: exact host, ".suffix" for subdomains, or a full origin.
# Keep localhost entries out of production.
ALLOWED_ORIGINS=.crazygames.com,localhost,127.0.0.1
# Node test clients send no Origin header; never allow that in production.
ALLOW_EMPTY_ORIGIN=false
# Optional: only accept CrazyGames tokens issued for this game id.
CRAZYGAMES_GAME_ID=
# Continuous city cycle (seconds): free play → rush warning → Delivery Rush → results → intermission → free play …
FIRST_FREE_PLAY_SECONDS=90
FREE_PLAY_SECONDS=45
RUSH_WARNING_SECONDS=10
RUSH_SECONDS=240
RESULTS_SECONDS=15
INTERMISSION_SECONDS=20
# A client busy during the break (future ads) may delay free play by at most this much
BREAK_MAX_EXTRA_WAIT_SECONDS=8
# Joining a rush later than this → spectate until it ends (only with 2+ active couriers)
LATE_JOIN_SECONDS=45
RECONNECT_SECONDS=20

# Milestone 3 tuning / test hooks (all optional)
# Which disasters can be scheduled: tornado,flood  (or "none")
DISASTER_TYPES=tornado,flood
# Force specific flood zones (ids F1..F9 from shared.js) instead of random picks
FLOOD_ZONES=
# Force a tornado path "x,z;x,z;..." (ping-pongs); empty = random road walk
TORNADO_PATH=
# Restrict package types that spawn (box,groceries,crate,aquarium,sofa,piano,vip)
PACKAGE_POOL=
# Condition lost when dropping a fragile package while running (default 12)
DROP_DAMAGE=

# Milestone 4 tuning / test hooks (all optional)
# Rolling disaster schedule: first event after N s, then a fixed gap (default: 30 s free play / 16 s rush)
DISASTER_FIRST_DELAY=
DISASTER_GAP=
DISASTER_WARN=
DISASTER_ACTIVE=
# Golden Package: seconds into the rush (default random 45-100), spot index (shared.js GOLDEN.spots), lifetime
GOLDEN_AT=
GOLDEN_SPOT=
GOLDEN_LIFETIME=
# Idle seconds before a pushed prop goes back home (default 60)
PROP_RESET_SECONDS=

# Bots: top rooms with real players up to BOT_FILL couriers (0 = off). Real players always replace bots.
BOT_FILL=4
BOT_JOIN_DELAY=2.5
BOTS_IN_PRIVATE=true
# 1 = show a 🤖 prefix on bot names
BOT_TAG=0
